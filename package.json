{
  "name": "fitoutpermits-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:sync": "node --test scripts/test-sync-to-prod.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run verify:deployment",
    "assets:images": "node scripts/optimize-images.mjs",
    "assets:placeholders": "node scripts/make-placeholders.mjs",
    "pages:deploy": "npm run check && wrangler pages deploy out",
    "pages:preview": "wrangler pages dev out"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.5.1",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^11.11.17",
    "lenis": "^1.1.20",
    "lucide-react": "^0.462.0",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "4.156.2"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "3.8.3",
    "next": {
      "postcss": "$postcss"
    }
  }
}

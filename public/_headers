# Cloudflare applies these rules using the request URL, even when the same
# production export is available on pages.dev or a custom staging hostname.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

https://fitoutpermits.ae/*
  ! X-Robots-Tag

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
